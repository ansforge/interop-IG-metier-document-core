       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Logical model - FR LM Legal Authentication" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Représente le responsable du document, qui est : \n - soit le professionnel qui prend la responsabilité du document produit par un lui-même ou un autre professionnel. \n - soit le professionnel qui prend la responsabilité du document produit par un système de structure (ES, …). \n - soit le patient/usager responsable du document d'expression personnelle \n - soit le SNR responsable du document produit via ce SNR. \n - Soit le Dossier Pharmaceutique (DP) responsable des documents qu'il produit" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ImplementationGuide.definition.resource.groupingId [ fhir:value "metier-entete" ]
